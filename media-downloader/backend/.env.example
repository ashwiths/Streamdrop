# StreamDrop Backend — Environment Variables
# Copy this to .env for local development.
# Set these in Railway's Variables dashboard for production.

# ── Server ────────────────────────────────────────────────────────────────────
# Railway injects PORT automatically. Only needed locally.
PORT=5000

# ── Environment ───────────────────────────────────────────────────────────────
NODE_ENV=production

# ── CORS ──────────────────────────────────────────────────────────────────────
# Your Vercel frontend URL (without trailing slash)
FRONTEND_URL=https://linkdownload-orpin.vercel.app
