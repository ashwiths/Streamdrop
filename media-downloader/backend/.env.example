# StreamDrop Backend — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# LOCAL: Copy this file to .env and fill in values.
# RAILWAY: Set these in Railway → Project → Variables tab (NOT in this file).

# ── Server ─────────────────────────────────────────────────────────────────────
# Railway auto-injects PORT. Only needed for local dev.
PORT=5000

# ── Environment ───────────────────────────────────────────────────────────────
NODE_ENV=production

# ── CORS ──────────────────────────────────────────────────────────────────────
# Your Vercel frontend URL (no trailing slash).
# Must match exactly what the browser sends in the Origin header.
FRONTEND_URL=https://linkdownload-orpin.vercel.app
